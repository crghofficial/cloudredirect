<Page x:Class="CloudRedirect.Pages.SaveRulesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:CloudRedirect.Resources"
      ScrollViewer.CanContentScroll="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="800">

            <TextBlock Text="{res:Loc Rules_Title}"
                       FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="0,0,0,8" />
            <TextBlock Text="{res:Loc Rules_Description}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,16" />

            <ui:CardControl Margin="0,0,0,12">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{res:Loc Rules_SteamState}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="SteamState" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:SymbolIcon x:Name="SteamStateIcon" Symbol="Desktop24" FontSize="24" />
            </ui:CardControl>

            <TextBlock Text="{res:Loc Rules_Game}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,8,0,4" />
            <ComboBox x:Name="GameBox" DisplayMemberPath="Name"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="GameBox_SelectionChanged" />
            <TextBlock x:Name="GameInfo" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <TextBlock Text="{res:Loc Rules_Suggestions}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,16,0,4" />
            <ComboBox x:Name="SuggestBox" DisplayMemberPath="Label"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="Suggest_SelectionChanged" />
            <TextBlock x:Name="SuggestInfo" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <TextBlock Text="{res:Loc Rules_Folder}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,16,0,4" />
            <DockPanel>
                <ui:Button x:Name="ChooseButton" DockPanel.Dock="Right"
                           Content="{res:Loc Rules_Choose}"
                           Icon="{ui:SymbolIcon FolderOpen24}"
                           Margin="8,0,0,0" Click="Choose_Click" />
                <TextBlock x:Name="FolderText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="{res:Loc Rules_NoFolder}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </DockPanel>

            <TextBlock Text="{res:Loc Rules_Pattern}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,16,0,4" />
            <ComboBox x:Name="PatternBox" IsEditable="True" Text="*"
                      HorizontalAlignment="Stretch"
                      LostFocus="Pattern_Changed" SelectionChanged="Pattern_Changed">
                <ComboBoxItem Content="*" />
                <ComboBoxItem Content="*.sav" />
                <ComboBoxItem Content="*.dat" />
                <ComboBoxItem Content="*.json" />
                <ComboBoxItem Content="*.bin" />
            </ComboBox>
            <CheckBox x:Name="RecursiveBox" Content="{res:Loc Rules_Recursive}" IsChecked="True" Margin="0,8,0,0"
                      Checked="Pattern_Changed" Unchecked="Pattern_Changed" />

            <ui:CardControl Margin="0,16,0,12">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{res:Loc Rules_Preview}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="RuleSummary" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="StatsText" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="SampleText" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:SymbolIcon Symbol="DocumentSave24" FontSize="24" />
            </ui:CardControl>

            <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,0,0,12" />

            <WrapPanel>
                <ui:Button x:Name="BackupButton" Content="{res:Loc Rules_CopySaves}"
                           Icon="{ui:SymbolIcon Archive24}"
                           Margin="0,0,8,8" Click="Backup_Click" />
                <ui:Button x:Name="SaveButton" Content="{res:Loc Rules_Write}"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon Save24}"
                           Margin="0,0,8,8" Click="Save_Click" />
            </WrapPanel>

            <TextBlock Text="{res:Loc Rules_RestoreTitle}" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,24,0,8" />
            <DockPanel>
                <ui:Button x:Name="RestoreButton" DockPanel.Dock="Right"
                           Content="{res:Loc Rules_Restore}"
                           Icon="{ui:SymbolIcon History24}"
                           Margin="8,0,0,0" Click="Restore_Click" />
                <ComboBox x:Name="BackupBox" DisplayMemberPath="Label" HorizontalAlignment="Stretch" />
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
