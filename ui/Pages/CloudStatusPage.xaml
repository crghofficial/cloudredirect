<Page x:Class="CloudRedirect.Pages.CloudStatusPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:CloudRedirect.Resources"
      ScrollViewer.CanContentScroll="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="800">

            <DockPanel Margin="0,0,0,24">
                <ui:Button DockPanel.Dock="Right"
                           Content="{res:Loc Status_Refresh}"
                           Icon="{ui:SymbolIcon ArrowSync24}"
                           VerticalAlignment="Center"
                           Click="Refresh_Click" />
                <TextBlock Text="{res:Loc Status_Title}"
                           FontSize="28" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </DockPanel>

            <ui:CardControl Margin="0,0,0,12">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{res:Loc Status_Health}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="HealthHeadline"
                                   Text="{res:Loc Status_Loading}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="HealthDetails"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:SymbolIcon x:Name="HealthIcon" Symbol="PlugConnected24" FontSize="24" />
            </ui:CardControl>

            <TextBlock Text="{res:Loc Status_Games}"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="0,12,0,12" />

            <TextBlock x:Name="GamesEmpty"
                       Visibility="Collapsed"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <StackPanel x:Name="GamesList" />
        </StackPanel>
    </ScrollViewer>
</Page>
